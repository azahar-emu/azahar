<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <!-- Left half of the cover screen sends trigger R, it is mirrored -->
    <View
        android:id="@+id/touch_zone_l"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#33FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guideline_center" />

    <!-- Right half of cover screen sends trigger L, it is mirrored -->
    <View
        android:id="@+id/touch_zone_r"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#33FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/guideline_center"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/fold_cover_label_left"
        android:textColor="#55FFFFFF"
        android:textSize="48sp"
        android:textStyle="bold"
        android:importantForAccessibility="no"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintTop_toTopOf="@id/touch_zone_l"
        app:layout_constraintBottom_toBottomOf="@id/touch_zone_l"
        app:layout_constraintStart_toStartOf="@id/touch_zone_l"
        app:layout_constraintEnd_toEndOf="@id/touch_zone_l" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/fold_cover_label_right"
        android:textColor="#55FFFFFF"
        android:textSize="48sp"
        android:textStyle="bold"
        android:importantForAccessibility="no"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintTop_toTopOf="@id/touch_zone_r"
        app:layout_constraintBottom_toBottomOf="@id/touch_zone_r"
        app:layout_constraintStart_toStartOf="@id/touch_zone_r"
        app:layout_constraintEnd_toEndOf="@id/touch_zone_r" />

    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="#33FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/guideline_center"
        app:layout_constraintEnd_toEndOf="@id/guideline_center" />
</androidx.constraintlayout.widget.ConstraintLayout>
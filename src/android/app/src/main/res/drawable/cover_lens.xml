<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <solid android:color="#0C0C0E" />
            <stroke android:width="1dp" android:color="#3A3A3E" />
        </shape>
    </item>

    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <gradient android:angle="270"
                android:startColor="#B4B4B8" android:endColor="#6A6A70" />
        </shape>
    </item>

    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="oval">
            <solid android:color="#101012" />
        </shape>
    </item>

    <item android:left="11dp" android:top="11dp" android:right="11dp" android:bottom="11dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="9dp"
                android:startColor="#44444A" android:endColor="#1A1A1E" />
        </shape>
    </item>

    <item android:left="17dp" android:top="17dp" android:right="17dp" android:bottom="17dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="3dp"
                android:startColor="#8E8E96" android:endColor="#5A5A62" />
        </shape>
    </item>

    <item>
        <shape android:shape="oval">
            <gradient android:angle="270"
                android:startColor="#3382231F"
                android:centerColor="#0082231F"
                android:endColor="#0082231F" />
        </shape>
    </item>
</layer-list>

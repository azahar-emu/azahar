<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#82231F" />
            <corners android:topLeftRadius="14dp" android:topRightRadius="26dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0"
                android:startColor="#4A0B0F"
                android:centerColor="#004A0B0F"
                android:endColor="#004A0B0F"
                android:centerX="0.03" />
            <corners android:topLeftRadius="14dp" android:topRightRadius="26dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="180"
                android:startColor="#4A0B0F"
                android:centerColor="#004A0B0F"
                android:endColor="#004A0B0F"
                android:centerX="0.03" />
            <corners android:topLeftRadius="14dp" android:topRightRadius="26dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270"
                android:startColor="#4A0B0F"
                android:centerColor="#004A0B0F"
                android:endColor="#004A0B0F"
                android:centerY="0.08" />
            <corners android:topLeftRadius="14dp" android:topRightRadius="26dp" />
        </shape>
    </item>
</layer-list>

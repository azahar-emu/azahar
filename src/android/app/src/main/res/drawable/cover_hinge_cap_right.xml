<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270"
                android:startColor="#9A271C"
                android:endColor="#6C150F" />
            <corners android:topRightRadius="6dp" android:bottomRightRadius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#4A0A0E" />
            <corners android:topRightRadius="6dp" android:bottomRightRadius="10dp" />
        </shape>
    </item>
</layer-list>
